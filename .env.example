# ===================================================
# RÙA TAI ĐỎ · VLEARN ADAPTIVE STUDIO ENVIRONMENT CONFIG
# ===================================================
# HƯỚNG DẪN BẢO MẬT:
# 1. Copy file này thành .env (File .env đã được đưa vào .gitignore, không bao giờ commit lên GitHub)
# 2. Nhập Gemini API Key từ Google AI Studio: https://aistudio.google.com/
# 3. Hoặc bạn có thể nhập trực tiếp trên giao diện Web Prototype qua nút "🔑 Cấu hình AI & Bảo mật"
# ===================================================

# Google Gemini API Key (Không commit file này khi đã điền key!)
GEMINI_API_KEY=AIzaSyYourGeminiApiKeyHere

# Model Name
GEMINI_MODEL=gemini-1.5-flash

# Security & PII Protection Mode
PII_SANITIZATION_ENABLED=true
GROUNDING_VERIFICATION_STRICT=true
SESSION_ONLY_STORAGE=true
